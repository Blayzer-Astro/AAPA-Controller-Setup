<Window x:Class="AAPASetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAPA Setup Beta 10" Height="600" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">
    
    <Window.Resources>
        <!-- Glassmorphism Style -->
        <Style TargetType="Border" x:Key="GlassBorder">
            <Setter Property="Background" Value="#AA1A1A24"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF00C6FF" Offset="0.0"/>
                        <GradientStop Color="#FF0072FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF33D6FF" Offset="0.0"/>
                                <GradientStop Color="#FF3392FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Modern ScrollBar Thumb -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#666666" CornerRadius="4" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource GlassBorder}">
        <!-- Inner background gradient to simulate depth -->
        <Border CornerRadius="15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DD101018" Offset="0.0"/>
                    <GradientStop Color="#EE05050A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="AAPA CONTROLLER SETUP" Foreground="#00C6FF" FontSize="22" FontWeight="Black" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bgBorder" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,20" FontSize="13">
                    Welcome to the AAPA Controller setup!
                </TextBlock>

                <!-- Main Content -->
                <StackPanel Grid.Row="2">
                    
                    <!-- NINA Plugin Section -->
                    <Border Background="#1AFFFFFF" CornerRadius="10" Padding="15">
                        <StackPanel>
                            <TextBlock Text="NINA Plugin" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Installs the AAPA Controller Plugin to NINA's plugin directory." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button x:Name="BtnInstallPlugin" Content="Install NINA Plugin" Style="{StaticResource ModernButton}" Height="35" Click="BtnInstallPlugin_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Firmware Section -->
                    <Border Background="#1AFFFFFF" CornerRadius="10" Padding="15" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="AAPA Firmware" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Flashes the compiled firmware binaries to the control board." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="COM Port:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbPorts" Grid.Column="1" Height="28"/>
                                <Button Grid.Column="2" Content="↻" Width="28" Height="28" Margin="5,0,0,0" Click="BtnRefreshPorts_Click" Background="#333333" Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#666666"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Button x:Name="BtnFlash" Content="Flash Firmware" Style="{StaticResource ModernButton}" Height="35" Click="BtnFlash_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Status Log -->
                <Border Grid.Row="3" Background="#0A000000" CornerRadius="5" Padding="10" Margin="0,20,0,0" BorderBrush="#33FFFFFF" BorderThickness="1" MinHeight="100">
                    <TextBox x:Name="TxtStatus" Foreground="#00C6FF" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
                </Border>

                <!-- Footer Links & Version -->
                <Grid Grid.Row="4" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Foreground="#AAAAAA" FontSize="12">
                            <Hyperlink NavigateUri="https://astrophiloslab.com/aapa" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#00C6FF" TextDecorations="None">AAPA Website</Hyperlink>
                            <Run Text="  •  "/>
                            <Hyperlink NavigateUri="https://github.com/Blayzer-Astro/AAPA-Controller-Setup" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#00C6FF" TextDecorations="None">AAPA Controller Setup GitHub</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Beta_15" Foreground="#444444" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>

            </Grid>
        </Border>
    </Border>
</Window>
